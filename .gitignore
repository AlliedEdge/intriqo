# =============================================================================
# Intriqo — .gitignore
# Stack: C++ (CMake), Python (FastAPI / agents), React/TypeScript/Vite, Docker
# =============================================================================


# =============================================================================
# C++ / CMake
# =============================================================================
build/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
CMakeUserPresets.json
compile_commands.json
CTestTestfile.cmake
_deps/
*.o
*.obj
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.pdb
*.ilk
*.exp
*.lib
# Generated headers / sources
engine/include/intriqo/version.hpp.in.generated
engine/src/generated/

# CMake install prefix (local dev installs)
install/
dist_cpp/


# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/
ENV/
.env.venv/

# Packaging / distribution
dist/
*.egg-info/
*.egg
.eggs/
MANIFEST

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
nosetests.xml
coverage.xml
*.cover

# Type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/

# Linters
.ruff_cache/

# Jupyter notebooks
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# pyenv
.python-version


# =============================================================================
# Node.js / npm / pnpm / yarn (frontend/)
# =============================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*

# Frontend build output
frontend/**/dist/
frontend/**/.vite/
frontend/**/build/
frontend/**/.next/
frontend/**/.nuxt/
frontend/**/coverage/

# TypeScript build info
*.tsbuildinfo


# =============================================================================
# ML — large binary / experiment artifacts
# =============================================================================
# Trained model artifacts — use Git LFS or a model registry for these
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.h5
ml/models/*.pt
ml/models/*.pth
ml/models/*.bin
ml/models/*.onnx
ml/models/*.safetensors
!ml/models/.gitkeep

# Experiment outputs and generated datasets
ml/experiments/*/output/
ml/experiments/*/artifacts/
ml/datasets/raw/*.csv
ml/datasets/raw/*.json
ml/datasets/raw/*.parquet
ml/datasets/raw/*.gz
ml/datasets/raw/*.tar
ml/datasets/processed/*.csv
ml/datasets/processed/*.parquet

# Notebook checkpoints already covered above


# =============================================================================
# Secrets and environment — NEVER commit these
# =============================================================================
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.jks
*.pfx
*.keystore
*.truststore
secrets/
credentials/
local-config/
*_secret*
*_secrets*


# =============================================================================
# Docker
# =============================================================================
# Local override compose files (contain secrets / local paths)
docker-compose.override.yml
docker-compose.local.yml
docker-compose.dev.yml

# Runtime volumes mounted locally
infrastructure/postgres/data/
infrastructure/redis/data/
infrastructure/kafka/data/
infrastructure/observability/grafana/data/


# =============================================================================
# Frontend public media assets — large binaries served from CDN / external storage
# Posters and video files are not committed; reference them via URL or CDN in code
# =============================================================================
frontend/**/public/assets/hero/*.mp4
frontend/**/public/assets/hero/*.webm
frontend/**/public/assets/hero/*.mov
frontend/**/public/assets/hero/*.jpg
frontend/**/public/assets/hero/*.webp
frontend/**/public/assets/hero/*.png
# Duplicate logo copies (canonical copy lives in assets/branding/)
# Exception: favicon.svg is intentionally served from public/
frontend/**/public/intriqo-logo.svg

# =============================================================================
# Datasets and PCAPs — large binary/data files
# Use Git LFS or external storage for real capture files
# =============================================================================
datasets/*.csv
datasets/*.json
datasets/*.parquet
datasets/*.pcap
datasets/*.pcapng
datasets/*.cap
datasets/*.zip
datasets/*.gz
datasets/*.tar

pcaps/*.pcap
pcaps/*.pcapng
pcaps/*.cap

security-lab/pcaps/*.pcap
security-lab/pcaps/*.pcapng
security-lab/pcaps/*.cap


# =============================================================================
# AI / agentic tool directories
# =============================================================================
.opencode/
.cursor/
.aider*

# =============================================================================
# IDE — IntelliJ IDEA
# =============================================================================
.idea/
*.iws
*.iml
*.ipr
out/

# =============================================================================
# IDE — VS Code
# =============================================================================
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.template

# =============================================================================
# IDE — Eclipse / NetBeans
# =============================================================================
.classpath
.project
.settings/
nbproject/private/
nbbuild/
nbdist/
.nb-gradle/


# =============================================================================
# Benchmarks — raw result files are large; scenarios are committed
# =============================================================================
benchmarks/*/results/
tests/performance/results/


# =============================================================================
# Logs
# =============================================================================
*.log
logs/
log/


# =============================================================================
# Temporary / OS
# =============================================================================
tmp/
temp/
.cache/
.tmp/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# Swap files
*.swp
*.swo
*.orig
*.bak
