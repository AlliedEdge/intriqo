{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://intriqo.dev/contracts/agents/agent_result_v1.json",
  "title": "AgentResult",
  "description": "Structured result returned by an agent to the control plane.",
  "type": "object",
  "required": ["task_id", "agent_name", "status", "confidence"],
  "additionalProperties": false,
  "properties": {
    "task_id":    { "type": "string", "minLength": 1 },
    "agent_name": { "type": "string", "minLength": 1 },
    "status":     { "type": "string", "enum": ["SUCCESS", "FAILED", "INCONCLUSIVE"] },
    "findings": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Structured textual findings produced by the agent."
    },
    "evidence": {
      "type": "array",
      "items": { "type": "object", "additionalProperties": true },
      "description": "Machine-readable evidence records."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Agent confidence score (0.0 = no confidence, 1.0 = certain)."
    },
    "summary":    { "type": ["string", "null"] },
    "error":      { "type": ["object", "null"], "additionalProperties": true },
    "metadata":   { "type": "object", "additionalProperties": true },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
