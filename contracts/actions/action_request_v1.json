{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://intriqo.dev/contracts/actions/action_request_v1.json",
  "title": "ActionRequest",
  "description": "A structured action proposed by an agent. Must pass policy evaluation before execution.",
  "type": "object",
  "required": ["action_type", "target", "requesting_agent", "justification", "confidence"],
  "additionalProperties": false,
  "properties": {
    "action_type": {
      "type": "string",
      "enum": ["BLOCK_IP", "ISOLATE_HOST", "QUARANTINE", "CREATE_TICKET", "NOTIFY_ANALYST", "ENRICH_IOC"],
      "description": "The type of action being requested. Only explicit registered types are permitted."
    },
    "target":            { "type": "string", "minLength": 1, "description": "The resource being acted upon." },
    "parameters":        { "type": "object", "additionalProperties": true },
    "requesting_agent":  { "type": "string", "minLength": 1 },
    "justification":     { "type": "string", "minLength": 1, "description": "Agent-provided reasoning for the action." },
    "confidence":        { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "task_id":           { "type": "string", "description": "The AgentTask that produced this request." }
  }
}
