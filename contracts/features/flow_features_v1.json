{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://intriqo.dev/contracts/features/flow_features_v1.json",
  "title": "FlowFeatureRecord",
  "description": "Immutable flow measurements emitted on retirement; all fields required, no ML execution or feature recalculation. Generated by intriqo_ml.flow_features.flow_feature_json_schema.",
  "$comment": "The Python parser additionally enforces: at most 8192 UTF-8 bytes excluding a single LF/CRLF; at most 16 nested JSON containers; no duplicate keys; no NaN/Infinity, including numeric overflow; integer fields require integer JSON tokens (not 1.0); real calendar dates (year 0001..9999, no leap seconds); timestamp >= first_seen; directional packet/byte sums equal totals; empty packet direction has zero bytes; each TCP flag count <= packet_count; initial_syn_count + syn_ack_count <= syn_count; syn_count + ack_count <= packet_count; started implies forward initial SYN evidence; syn_ack_seen implies started and reverse SYN ACK evidence; completed implies syn_ack_seen, ACK evidence and at least two forward packets; non-TCP records have zero TCP counts and false handshake booleans. Draft-07 cannot express these cross-field/token/transport rules. Enable format assertions for date-time/ipv4 checks; use the Python parser for complete validation. Timestamp strings preserve all nine fractional digits, and no rates are recomputed or normalized.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "metadata", "features"],
  "properties": {
    "schema_version": {"type": "string", "const": "flow_features.v1", "title": "Schema Version"},
    "metadata": {"$ref": "#/definitions/FlowMetadata"},
    "features": {"$ref": "#/definitions/FlowFeatures"}
  },
  "definitions": {
    "FlowMetadata": {
      "title": "FlowMetadata",
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_instance_id", "flow_id", "first_seen", "timestamp", "export_reason", "network"],
      "properties": {
        "engine_instance_id": {
          "type": "string", "title": "Engine Instance Id", "minLength": 36, "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "flow_id": {
          "type": "string", "title": "Flow Id", "minLength": 1, "maxLength": 20,
          "not": {"pattern": "[^0-9]"},
          "pattern": "^([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$"
        },
        "first_seen": {
          "type": "string", "title": "First Seen", "format": "date-time", "minLength": 30, "maxLength": 30,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{9}Z$"
        },
        "timestamp": {
          "type": "string", "title": "Timestamp", "format": "date-time", "minLength": 30, "maxLength": 30,
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{9}Z$"
        },
        "export_reason": {
          "type": "string", "title": "Export Reason", "enum": ["idle_expired", "capacity_evicted", "shutdown_flush"]
        },
        "network": {"$ref": "#/definitions/FlowNetwork"}
      }
    },
    "FlowNetwork": {
      "title": "FlowNetwork",
      "type": "object",
      "additionalProperties": false,
      "required": ["src_ip", "dst_ip", "src_port", "dst_port", "protocol"],
      "properties": {
        "src_ip": {
          "type": "string", "title": "Src Ip", "format": "ipv4", "minLength": 7, "maxLength": 15,
          "not": {"pattern": "[^0-9.]"},
          "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]|[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]|[0-9])){3}$"
        },
        "dst_ip": {
          "type": "string", "title": "Dst Ip", "format": "ipv4", "minLength": 7, "maxLength": 15,
          "not": {"pattern": "[^0-9.]"},
          "pattern": "^(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]|[0-9])(\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9][0-9]|[0-9])){3}$"
        },
        "src_port": {"type": "integer", "title": "Src Port", "minimum": 0, "maximum": 65535},
        "dst_port": {"type": "integer", "title": "Dst Port", "minimum": 0, "maximum": 65535},
        "protocol": {"type": "string", "title": "Protocol", "enum": ["TCP", "UDP", "ICMP", "OTHER"]}
      }
    },
    "FlowFeatures": {
      "title": "FlowFeatures",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_count", "byte_count", "duration_seconds", "bytes_per_packet", "packets_per_second", "bytes_per_second",
        "fwd_packet_count", "rev_packet_count", "fwd_byte_count", "rev_byte_count", "syn_count", "fin_count", "rst_count",
        "initial_syn_count", "syn_ack_count", "ack_count", "tcp_handshake_started", "tcp_syn_ack_seen", "tcp_handshake_completed"
      ],
      "properties": {
        "packet_count": {"type": "integer", "title": "Packet Count", "minimum": 0, "maximum": 18446744073709551615},
        "byte_count": {"type": "integer", "title": "Byte Count", "minimum": 0, "maximum": 18446744073709551615},
        "duration_seconds": {"type": "number", "title": "Duration Seconds", "minimum": 0, "maximum": 1.7976931348623157e+308},
        "bytes_per_packet": {"type": "number", "title": "Bytes Per Packet", "minimum": 0, "maximum": 1.7976931348623157e+308},
        "packets_per_second": {"type": "number", "title": "Packets Per Second", "minimum": 0, "maximum": 1.7976931348623157e+308},
        "bytes_per_second": {"type": "number", "title": "Bytes Per Second", "minimum": 0, "maximum": 1.7976931348623157e+308},
        "fwd_packet_count": {"type": "integer", "title": "Fwd Packet Count", "minimum": 0, "maximum": 18446744073709551615},
        "rev_packet_count": {"type": "integer", "title": "Rev Packet Count", "minimum": 0, "maximum": 18446744073709551615},
        "fwd_byte_count": {"type": "integer", "title": "Fwd Byte Count", "minimum": 0, "maximum": 18446744073709551615},
        "rev_byte_count": {"type": "integer", "title": "Rev Byte Count", "minimum": 0, "maximum": 18446744073709551615},
        "syn_count": {"type": "integer", "title": "Syn Count", "minimum": 0, "maximum": 4294967295},
        "fin_count": {"type": "integer", "title": "Fin Count", "minimum": 0, "maximum": 4294967295},
        "rst_count": {"type": "integer", "title": "Rst Count", "minimum": 0, "maximum": 4294967295},
        "initial_syn_count": {"type": "integer", "title": "Initial Syn Count", "minimum": 0, "maximum": 4294967295},
        "syn_ack_count": {"type": "integer", "title": "Syn Ack Count", "minimum": 0, "maximum": 4294967295},
        "ack_count": {"type": "integer", "title": "Ack Count", "minimum": 0, "maximum": 4294967295},
        "tcp_handshake_started": {"type": "boolean", "title": "Tcp Handshake Started"},
        "tcp_syn_ack_seen": {"type": "boolean", "title": "Tcp Syn Ack Seen"},
        "tcp_handshake_completed": {"type": "boolean", "title": "Tcp Handshake Completed"}
      }
    }
  }
}
