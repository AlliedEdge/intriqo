# Intriqo local development configuration.
# Copy to .env before starting the host-process runtime:
#   cp .env.example .env
# Keep .env local; never commit credentials or production values.

APP_ENV=development
DEBUG=false
# Leave empty in local development; the launcher creates a private random key
# under .intriqo/. Set an explicit >=32 character secret outside Git for other
# environments.
JWT_SECRET_KEY=

# PostgreSQL is the only service started by scripts/start-intriqo.sh.
POSTGRES_USER=intriqo
POSTGRES_PASSWORD=intriqo_dev
POSTGRES_DB=intriqo
DATABASE_URL=postgresql+asyncpg://intriqo:intriqo_dev@127.0.0.1:5432/intriqo
INTRIQO_POSTGRES_HOST=127.0.0.1
INTRIQO_POSTGRES_PORT=5432

# Control Plane and browser-facing development URLs. The INTRIQO_* names are
# the existing engine/ML/agent configuration names; the short names are listed
# in docs/local-development.md as their role in the stack.
INTRIQO_API_HOST=127.0.0.1
INTRIQO_API_PORT=8000
INTRIQO_CONTROL_PLANE_URL=http://127.0.0.1:8000
INTRIQO_CONTROL_PLANE_ENDPOINT=/api/v1/events
INTRIQO_CONTROL_PLANE_TOKEN=
INTRIQO_AGENT_TOKEN=
FRONTEND_BASE_URL=http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# The stack uses the existing polling entry point. Leave the task ID empty to
# poll recoverable persisted investigation tasks.
INTRIQO_AGENTS_ENABLED=true
INTRIQO_AGENT_TASK_ID=
INTRIQO_AGENT_POLL_INTERVAL=2

# Vite dashboard.
INTRIQO_FRONTEND_ENABLED=true
INTRIQO_FRONTEND_HOST=127.0.0.1
INTRIQO_FRONTEND_PORT=5173

# Synthetic engine execution is safe and finite by default. Live capture still
# needs an explicitly authorised interface and an explicit mode/source.
INTRIQO_ENGINE_ENABLED=true
INTRIQO_ENGINE_MODE=synthetic
INTRIQO_ENGINE_BIN=
INTRIQO_ENGINE_SOURCE=
INTRIQO_ENGINE_SYNTHETIC_PACKETS=10
INTRIQO_ENGINE_SINK=http
INTRIQO_ENGINE_EVENT_QUEUE_CAPACITY=0
INTRIQO_ENGINE_LOG_LEVEL=info
INTRIQO_ENGINE_FILTER=
INTRIQO_ENGINE_NO_PROMISCUOUS=false

# ML is disabled unless explicitly enabled. When enabled, all artifact paths
# and hashes are validated before the separate worker is launched.
INTRIQO_ML_ENABLED=false
INTRIQO_ML_MODEL_PATH=
INTRIQO_ML_THRESHOLD_PATH=
INTRIQO_ML_FEATURE_SCHEMA_PATH=
INTRIQO_ML_FEATURE_CONTRACT_PATH=contracts/features/flow_features_v2.json
INTRIQO_ML_MODEL_METADATA_PATH=
INTRIQO_ML_EXPECTED_MODEL_SHA256=
INTRIQO_ML_EXPECTED_THRESHOLD_SHA256=
INTRIQO_ML_MAX_DEDUP_ENTRIES=100000
INTRIQO_ML_TRANSPORT_TIMEOUT_SECONDS=5
INTRIQO_ML_TRANSPORT_MAX_ATTEMPTS=1
INTRIQO_ML_QUEUE_CAPACITY=256
INTRIQO_JWT_REFRESH_MARGIN_SECONDS=300

# Runtime-owned PID, log, and state directories.
INTRIQO_RUNTIME_DIR=.intriqo
INTRIQO_STARTUP_TIMEOUT_SECONDS=60
INTRIQO_SHUTDOWN_TIMEOUT_SECONDS=15
